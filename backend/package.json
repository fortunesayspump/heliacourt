{
  "name": "@helia-court/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "agents:smoke": "tsx src/scripts/smoke-witnesses.ts",
    "agents:sync-onchain": "tsx src/scripts/sync-agent-registry-onchain.ts",
    "agents:register-erc8004": "tsx src/scripts/register-erc8004-agent.ts",
    "agents:erc8004:info": "tsx src/scripts/register-erc8004-agent.ts --info",
    "agents:erc8004:update-uri": "tsx src/scripts/register-erc8004-agent.ts --update-uri",
    "onchain:approve-settlement-signer": "tsx src/scripts/approve-settlement-signer.ts",
    "hearing": "tsx src/scripts/run-hearing.ts",
    "start": "tsx src/server.ts",
    "start:web": "HELIA_ENABLE_HEARING_WORKER=false tsx src/server.ts",
    "start:worker": "tsx src/scripts/hearing-worker.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.0.4",
    "@fastify/cors": "^11.2.0",
    "@mozilla/readability": "^0.6.0",
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.10.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "viem": "^2.48.11",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
