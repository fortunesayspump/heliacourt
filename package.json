{
  "name": "helia-court-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:app": "pnpm --dir app dev",
    "dev:marketing": "pnpm --dir marketing dev",
    "dev:docs": "pnpm --dir docs dev",
    "dev:backend": "pnpm --dir backend dev",
    "x402": "pnpm --dir backend x402",
    "build:app": "pnpm --dir app build",
    "build:marketing": "pnpm --dir marketing build",
    "build:docs": "pnpm --dir docs build",
    "build:backend": "pnpm --dir backend build",
    "build:contracts": "pnpm --dir contracts build",
    "lint:app": "pnpm --dir app lint",
    "test:contracts": "pnpm --dir contracts test",
    "build": "pnpm build:app && pnpm build:marketing && pnpm build:docs && pnpm build:backend && pnpm build:contracts",
    "check": "pnpm lint:app && pnpm build && pnpm test:contracts"
  }
}
